# Generated locally by install-qqbot.ps1. Never commit the resulting .env.
MEMORY_BRIDGE_TOKEN=__LOCAL_TOKEN__
MEMORY_BRIDGE_URL=http://127.0.0.1:8765
MEMORY_BRIDGE_DATA_DIR=./data
MEMORY_MODE=pro
MEMORY_DATA_DIR=./data/hy-memory
MEMORY_PERSIST_DIR=./data/hy-memory/data/vector_db
MEMORY_COLLECTION_NAME=qq_chat_512
MEMORY_ENABLE_GRAPH=false
MEMORY_ENABLE_INTENTION=false
MEMORY_LOG_LLM_CONTENT=false
MEMORY_PIPELINE_TRACE_ENABLED=false

# LLM requests go through the native Cordis bridge and the existing DSH login.
MEMORY_LLM_API_KEY=__LOCAL_TOKEN__
MEMORY_LLM_BASE_URL=http://127.0.0.1:8766/v1
MEMORY_LLM_MODEL=deepseek-flash
MEMORY_LLM_TIMEOUT=90
MEMORY_LLM_MAX_RETRIES=1
MEMORY_LLM_MAX_TOKENS=1800
MEMORY_AGENT_MAX_TOKENS=2500
MEMORY_DSH_PROVIDER=deepseek-account
MEMORY_DSH_MODEL=deepseek-flash
# QQ main-Agent requests use explicit off even for resumed sessions.
QQBOT_REASONING_EFFORT=off
MEMORY_DSH_PORT=8766

# Separate local CPU embedding model: no DeepSeek embedding assumption/API key.
MEMORY_EMBEDDER_API_KEY=__LOCAL_TOKEN__
MEMORY_EMBEDDER_BASE_URL=http://127.0.0.1:8765/v1
MEMORY_EMBEDDER_MODEL=BAAI/bge-small-zh-v1.5
MEMORY_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
MEMORY_EMBEDDING_DIMS=512
MEMORY_EMBEDDER_TIMEOUT=15
HF_HUB_DISABLE_XET=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1
