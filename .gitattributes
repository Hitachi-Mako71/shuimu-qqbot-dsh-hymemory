* text=auto
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.patch text eol=lf
*.ps1 text eol=crlf
*.ico binary
*.tgz binary

# Preserve byte-identical pinned plugin payload and patch hashes across platforms.
app/dsh-hymemory-plugin/** -text
*.patch -text

# Existing deployed application and historical snapshots keep their bytes.
app/** -text
archive/** -text
